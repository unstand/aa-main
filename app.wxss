/**app.wxss**/
/* 
 * 设计规范基于 375×812px 画布 (iPhone X~13)
 * 换算规则：1px = 2rpx
 * 
 * 固定高度：
 *   状态栏 44px = 88rpx（刘海屏）
 *   自定义导航栏 44px = 88rpx
 *   TabBar 50px = 100rpx
 *   底部安全区 34px = 68rpx
 * 
 * 间距：
 *   页面边距 16px = 32rpx
 *   模块间距 16px/24px = 32rpx/48rpx
 *   8px栅格 = 16rpx
 * 
 * 字号：
 *   大标题 20px = 40rpx
 *   页面标题 18px = 36rpx
 *   正文 14px = 28rpx
 *   辅助文字 12px = 24rpx
 *   标签/备注 10px = 20rpx
 * 
 * 圆角：
 *   按钮 8px/12px = 16rpx/24rpx
 *   卡片 12px/16px = 24rpx/32rpx
 */

page {
  background-color: transparent;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  min-height: 100vh;
  background-color: transparent;
}

/* ==================== 暗色主题 ==================== */
.dark-bg {
  background-color: transparent;
}

/* ==================== 卡片 ==================== */
.card {
  background-color: transparent;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-light {
  background-color:transparent;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* ==================== 文字样式 ==================== */
.text-primary { color: #4ecdc4; }
.text-white { color: #ffffff; }
.text-gray { color: #8e8e9a; }
.text-price { color: #ff6b6b; font-weight: bold; }
.text-yellow { color: #ffd93d; }
.text-bold { font-weight: bold; }

.text-sm { font-size: 24rpx; }
.text-xs { font-size: 20rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 40rpx; }

/* ==================== 按钮 ==================== */
.btn-primary {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.btn-secondary {
  background-color: #3d5a80;
  color: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
}

.btn-outline {
  background: transparent;
  color: #4ecdc4;
  border: 2rpx solid #4ecdc4;
  border-radius: 24rpx;
  padding: 18rpx 38rpx;
  text-align: center;
  font-size: 28rpx;
}

/* ==================== 标签 ==================== */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-red {
  background-color: rgba(255, 107, 107, 0.2);
  color: #ff6b6b;
}

.tag-gray {
  background-color: rgba(142, 142, 154, 0.2);
  color: #c0c0c8;
}

.tag-blue {
  background-color: rgba(78, 205, 196, 0.2);
  color: #4ecdc4;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  display: flex;
  align-items: center;
  background-color: #2d2d44;
  border-radius: 24rpx;
  padding: 16rpx 32rpx;
  margin: 16rpx 32rpx;
}

.search-bar .search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-bar .search-input {
  flex: 1;
  color: #8e8e9a;
  font-size: 24rpx;
}

/* ==================== 底部操作栏 ==================== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #1e1e32;
  z-index: 100;
  height: auto;
  min-height: 100rpx;
}

.bottom-bar .price-info {
  flex: 1;
}

.bottom-bar .price-info .price-label {
  font-size: 24rpx;
  color: #8e8e9a;
}

.bottom-bar .price-info .price-value {
  font-size: 40rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.bottom-bar .action-btns {
  display: flex;
  gap: 16rpx;
}

.bottom-bar .action-btns .btn {
  padding: 20rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
  white-space: nowrap;
}

.bottom-bar .action-btns .btn-contact {
  background-color: #3d5a80;
  color: #ffffff;
}

.bottom-bar .action-btns .btn-action {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  color: #ffffff;
}

/* ==================== 数量选择器 ==================== */
.quantity-selector {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quantity-selector .btn-minus,
.quantity-selector .btn-plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #3d3d5c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.quantity-selector .btn-minus.disabled,
.quantity-selector .btn-plus.disabled {
  opacity: 0.3;
}

.quantity-selector .quantity-value {
  font-size: 32rpx;
  font-weight: bold;
  min-width: 48rpx;
  text-align: center;
}

/* ==================== 分割线 ==================== */
.divider {
  height: 1rpx;
  background-color: rgba(255, 255, 255, 0.1);
  margin: 16rpx 0;
}

/* ==================== 安全区域 ==================== */
.safe-bottom {
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ==================== 左侧分类导航 ==================== */
.category-sidebar {
  width: 176rpx;
  background-color: #232340;
  height: 100%;
}

.category-item {
  padding: 24rpx 16rpx;
  text-align: center;
  position: relative;
}

.category-item.active {
  background-color: #2d2d44;
}

.category-item.active::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background-color: #4ecdc4;
  border-radius: 3rpx;
}

.category-item .cat-name {
  font-size: 24rpx;
  color: #8e8e9a;
  margin-bottom: 8rpx;
}

.category-item.active .cat-name {
  color: #ffffff;
  font-weight: bold;
}

.category-item .cat-price {
  font-size: 20rpx;
  color: #ffd93d;
}

/* ==================== 通用 flex ==================== */
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }
