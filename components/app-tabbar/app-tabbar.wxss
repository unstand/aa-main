.bottom-nav {
  position: fixed;
  left: 50rpx;
  right: 50rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 30;
  height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 48rpx;
  background: rgba(31, 48, 60, 0.7);
  box-shadow:
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.18),
    0 10rpx 26rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.bottom-nav-item {
  width: 108rpx;
  height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bottom-nav-icon {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.62;
}

.bottom-nav-text {
  display: none;
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.bottom-nav-item.active .bottom-nav-icon {
  opacity: 1;
}

.bottom-nav-item.active .bottom-nav-text {
  display: block;
  color: #78f3ee;
}
