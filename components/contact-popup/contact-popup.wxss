.contact-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(9, 15, 24, 0.18);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 18rpx 18rpx;
  box-sizing: border-box;
}

.contact-sheet {
  position: absolute;
  bottom: 56rpx;
  width: 660rpx;
  min-height: 600rpx;
  padding: 28rpx 20rpx 20rpx;
  border-radius: 26rpx;
  background:
    linear-gradient(180deg, rgba(134, 143, 152, 0.34), rgba(110, 119, 128, 0.28)),
    rgba(98, 108, 118, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow:
    0 18rpx 42rpx rgba(8, 14, 22, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.contact-icons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 100rpx;
  margin-top: 40rpx;
  margin-bottom: 34rpx;
}

.contact-icon-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
}

.contact-icon-image {
  display: block;
}

.contact-icon-wechat,
.contact-icon-douyin {
  width: 100%;
  height: 100%;
}

.contact-icon-xiaohongshu {
  width: 100%;
  height: 100%;
}

.contact-phone {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  justify-content: center;
  margin: 48rpx 56rpx;
}

.contact-phone-image {
  width: 100%;
  height: 100%;
  display: block;
}

.contact-cancel {
  position: absolute;
  bottom: 40rpx;              /* 距离底部间距 */
  left: 50%;
  transform: translateX(-50%);
  width: 560rpx;
  max-width: 100%;
  height: 68rpx;
  border-radius: 24rpx;
  background: rgba(147, 238, 238, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 1);
  font-family: "Alimama FangYuanTi VF", sans-serif;
font-weight: 500; /* Medium */
font-size: 28rpx;    /* 14px × 2 = 28rpx */
line-height: 34rpx;  /* 17px × 2 = 34rpx */
letter-spacing: 0rpx;
text-align: center;
}
