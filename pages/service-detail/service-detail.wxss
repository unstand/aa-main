/* pages/service-detail/service-detail.wxss */
.detail-page {
  min-height: 100vh;
  background-color: #1a1a2e;
}

.content-scroll {
  height: calc(100vh - 120rpx);
  padding: 0 0 0 0;
}

/* ===== 产品图片区域 ===== */
.product-hero {
  padding: 20rpx 40rpx 0;
}

.hero-img-wrap {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.hero-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #3d3d5c, #2a2a44);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-icon {
  font-size: 100rpx;
  opacity: 0.4;
}

.video-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(78, 205, 196, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-icon {
  font-size: 24rpx;
  color: #ffffff;
}

/* ===== 产品信息 ===== */
.product-section {
  background-color: rgba(45, 45, 68, 0.7);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 40rpx;
}

.product-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 700;
  font-family: "HarmonyOS Sans";
}

.dropdown-icon {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.product-items {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

/* 数量价格 */
.quantity-price-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.quantity-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-right: 20rpx;
}

.quantity-selector {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: rgba(61, 61, 92, 0.8);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.qty-btn.disabled {
  opacity: 0.3;
}

.quantity-value {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
  min-width: 40rpx;
  text-align: center;
}

.unit-price {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 700;
  margin-left: auto;
  font-family: "HarmonyOS Sans";
}

/* 日期选择 */
.date-section {
  background-color: rgba(35, 35, 64, 0.6);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-item-right {
  justify-content: flex-end;
}

.date-value {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.date-arrow {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.4);
}

.date-duration {
  padding: 6rpx 16rpx;
  background-color: rgba(78, 205, 196, 0.12);
  border-radius: 16rpx;
}

.duration-text {
  font-size: 22rpx;
  color: #4ecdc4;
}

/* 地点 */
.location-section {
  background-color: rgba(35, 35, 64, 0.6);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.location-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.location-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  width: 120rpx;
}

.location-value {
  font-size: 24rpx;
  color: #ffffff;
}

/* ===== 套餐选择 ===== */
.package-section {
  margin: 0 40rpx 20rpx;
}

.package-scroll {
  white-space: nowrap;
}

.package-options {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.package-card {
  display: inline-block;
  width: 320rpx;
  white-space: normal;
  background-color: rgba(45, 45, 68, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 20rpx;
  vertical-align: top;
}

.package-card.selected {
  border-color: #4ecdc4;
  background-color: rgba(78, 205, 196, 0.06);
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.package-name {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
}

.package-price-add {
  font-size: 22rpx;
  color: #4ecdc4;
  font-weight: 500;
}

.package-items {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===== 使用须知 ===== */
.notice-section {
  margin: 0 40rpx 20rpx;
}

.notice-header {
  margin-bottom: 16rpx;
}

.notice-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  font-family: "HarmonyOS Sans";
}

.notice-underline {
  height: 4rpx;
  width: 100rpx;
  background-color: #4ecdc4;
  margin-top: 10rpx;
  border-radius: 2rpx;
}

.notice-content {
  border-radius: 16rpx;
  overflow: hidden;
}

.notice-img-placeholder {
  position: relative;
  width: 100%;
  height: 280rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.notice-bg-img {
  width: 100%;
  height: 100%;
}

.notice-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}

.safe-bottom {
  height: 140rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: rgba(30, 30, 50, 0.95);
  backdrop-filter: blur(12px);
  z-index: 100;
}

.bar-price {
  display: flex;
  align-items: baseline;
}

.bar-price-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.bar-price-value {
  font-size: 38rpx;
  color: #ffffff;
  font-weight: 700;
  font-family: "HarmonyOS Sans";
}

.bar-actions {
  display: flex;
  gap: 16rpx;
}

.bar-btn {
  padding: 16rpx 36rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-btn text {
  font-size: 26rpx;
  color: #ffffff;
  white-space: nowrap;
  font-weight: 500;
  font-family: "HarmonyOS Sans";
}

.bar-btn-contact {
  background-color: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.bar-btn-action {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
}
