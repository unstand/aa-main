page {
  height: 100%;
  background: #233245;
}

.detail-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #111214;
}

.page-bg,
.page-mask,
.page-frost {
  position: fixed;
  inset: 0;
}

.page-bg {
  width: 100%;
  height: 100%;
}

.page-mask {
  background:
    linear-gradient(180deg, rgba(11, 27, 49, 0.7) 0%, rgba(24, 24, 29, 0.18) 15%, rgba(41, 27, 22, 0.38) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(0, 0, 0, 0.1));
}

.page-frost {
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.status-bar {
  height: calc(44rpx + env(safe-area-inset-top));
}

.top-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 30rpx 10rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(41, 57, 79, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.nav-back-icon {
  font-size: 42rpx;
  color: #f0f3f8;
  line-height: 1;
}

.nav-actions {
  height: 48rpx;
  min-width: 148rpx;
  padding: 0 18rpx;
  border-radius: 26rpx;
  background: rgba(234, 236, 239, 0.72);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-dots {
  font-size: 30rpx;
  color: #121318;
  line-height: 1;
  margin-top: -6rpx;
}

.nav-split {
  width: 1rpx;
  height: 26rpx;
  background: rgba(0, 0, 0, 0.14);
}

.nav-circle {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 4rpx solid #111318;
  box-sizing: border-box;
}

.content-scroll {
  position: relative;
  z-index: 2;
  height: calc(100vh - 120rpx);
  padding: 22rpx 30rpx 0;
  box-sizing: border-box;
}

.glass-card {
  background: rgba(247, 241, 237, 0.74);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 32rpx;
  box-shadow:
    0 18rpx 42rpx rgba(7, 12, 20, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.36);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.hero-card {
  padding: 18rpx 18rpx 20rpx;
}

.hero-image-wrap {
  position: relative;
  height: 330rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #182230;
}

.hero-image {
  width: 100%;
  height: 100%;
  transform: scale(1.18);
}

.media-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #97eef1;
  color: #111214;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 16rpx;
  display: flex;
  justify-content: center;
}

.hero-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.48);
}

.hero-dot.active {
  background: #ffffff;
}

.service-summary {
  padding: 18rpx 14rpx 0;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.service-name {
  font-size: 30rpx;
  color: #445365;
  font-weight: 700;
}

.dropdown-icon {
  font-size: 18rpx;
  color: #556477;
}

.service-items {
  display: block;
  margin-top: 10rpx;
  font-size: 18rpx;
  line-height: 1.45;
  color: #6b7481;
}

.booking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0 14rpx;
}

.quantity-box {
  width: 302rpx;
  height: 62rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: rgba(187, 190, 197, 0.34);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.quantity-label {
  font-size: 22rpx;
  color: #7d8691;
  margin-right: 32rpx;
}

.quantity-action {
  width: 50rpx;
  text-align: center;
  font-size: 38rpx;
  color: #4e5b6c;
  line-height: 1;
}

.quantity-action.disabled {
  opacity: 0.35;
}

.quantity-value {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #17181b;
  font-weight: 700;
}

.price-text {
  font-size: 34rpx;
  color: #445365;
  font-weight: 700;
}

.date-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(187, 190, 197, 0.32);
}

.date-col {
  min-width: 176rpx;
}

.date-col-right {
  text-align: right;
}

.date-main-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-col-right .date-main-row {
  justify-content: flex-end;
}

.date-main {
  font-size: 28rpx;
  color: #151618;
  font-weight: 700;
}

.date-arrow {
  font-size: 16rpx;
  color: #536173;
}

.date-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #6d7684;
}

.date-center {
  font-size: 20rpx;
  color: #6a7380;
}

.location-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.location-card {
  border-radius: 22rpx;
  background: rgba(187, 190, 197, 0.32);
  padding: 18rpx 22rpx;
  box-sizing: border-box;
}

.city-card {
  width: 160rpx;
}

.location-card-wide {
  flex: 1;
}

.location-label {
  display: block;
  font-size: 20rpx;
  color: #78818d;
  margin-bottom: 18rpx;
}

.location-value {
  display: block;
  font-size: 22rpx;
  color: #151618;
  font-weight: 700;
}

.package-scroll {
  margin: 34rpx -30rpx 0;
  padding-left: 30rpx;
  white-space: nowrap;
}

.package-row {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 30rpx;
}

.package-card {
  width: 300rpx;
  height: 168rpx;
  padding: 18rpx 20rpx;
  border-radius: 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  background: rgba(247, 241, 237, 0.68);
  box-sizing: border-box;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.package-card.selected {
  border-color: #8ef5f6;
  box-shadow: inset 0 0 0 2rpx rgba(142, 245, 246, 0.12);
}

.package-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.package-name {
  font-size: 28rpx;
  color: #465567;
  font-weight: 700;
}

.package-price {
  font-size: 24rpx;
  color: #4f5e70;
  font-weight: 700;
}

.package-items {
  display: block;
  font-size: 18rpx;
  line-height: 1.45;
  color: #6e7884;
}

.notice-section {
  margin-top: 42rpx;
}

.notice-head {
  margin-bottom: 22rpx;
}

.notice-title {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 700;
}

.notice-line {
  width: 72rpx;
  height: 4rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.notice-panel {
  height: 368rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.18)),
    rgba(241, 241, 241, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

.bottom-space {
  height: 190rpx;
}

.bottom-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  padding: 0 28rpx calc(18rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  height: 98rpx;
  padding: 10rpx;
  border-radius: 32rpx;
  background: rgba(32, 42, 57, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  box-shadow:
    0 16rpx 36rpx rgba(6, 10, 18, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.total-box {
  width: 190rpx;
  height: 100%;
  padding-left: 18rpx;
  border-radius: 24rpx;
  background: rgba(18, 26, 39, 0.96);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.total-label,
.total-value {
  font-size: 22rpx;
  color: #8bebef;
  font-weight: 700;
}

.action-btn {
  height: 100%;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.contact-btn {
  width: 162rpx;
  margin-left: 12rpx;
  background: #8ceef0;
  color: #111214;
}

.primary-btn {
  flex: 1;
  margin-left: 12rpx;
  gap: 8rpx;
  background: #8ceef0;
  color: #111214;
}

.primary-free {
  font-size: 18rpx;
  font-style: italic;
  font-weight: 700;
}

.primary-text {
  font-size: 24rpx;
  font-weight: 700;
}

.contact-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(9, 15, 24, 0.18);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 18rpx 18rpx;
  box-sizing: border-box;
}

.contact-sheet {
  width: 100%;
  max-width: 574rpx;
  min-height: 294rpx;
  padding: 28rpx 20rpx 20rpx;
  border-radius: 26rpx;
  background:
    linear-gradient(180deg, rgba(134, 143, 152, 0.34), rgba(110, 119, 128, 0.28)),
    rgba(98, 108, 118, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow:
    0 18rpx 42rpx rgba(8, 14, 22, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.contact-icons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 54rpx;
  margin-top: 8rpx;
  margin-bottom: 34rpx;
}

.contact-icon-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
}

.contact-icon-image {
  display: block;
}

.contact-icon-wechat,
.contact-icon-douyin {
  width: 62rpx;
  height: 62rpx;
}

.contact-icon-xiaohongshu {
  width: 70rpx;
  height: 44rpx;
}

.contact-phone {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.contact-phone-image {
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.contact-cancel {
  width: 492rpx;
  max-width: 100%;
  height: 44rpx;
  margin: 0 auto;
  border-radius: 14rpx;
  background: #8ceef0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111214;
  font-size: 20rpx;
  font-weight: 700;
}
