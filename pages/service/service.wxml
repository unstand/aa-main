<view class="service-page">
  <image class="page-bg" src="/images/login-bj.png" mode="aspectFill" />
  <view class="bg-mask"></view>

  <view class="search-bar" style="{{searchBarStyle}}">
    <view class="search-inner">
      <input
        class="search-input"
        placeholder="请在找什么服务？"
        placeholder-class="search-placeholder"
        bindinput="onSearchInput"
        value="{{searchKeyword}}"
      />
      <image class="search-icon" src="/images/sousuo.png" mode="aspectFit" />
    </view>
    <view class="capsule-btn" style="{{capsuleStyle}}">
      <view class="capsule-dots">
        <view class="capsule-dot"></view>
        <view class="capsule-dot"></view>
        <view class="capsule-dot"></view>
      </view>
      <view class="capsule-split"></view>
      <view class="capsule-ring"></view>
    </view>
  </view>

  <view class="main-content">
    <scroll-view scroll-y class="category-sidebar" enhanced show-scrollbar="{{false}}">
      <view class="category-item {{activeCategory === index ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-index="{{index}}">
        <text class="sideservice-name">{{item.name}}</text>
        <text class="sideservice-price">¥{{item.price}}起</text>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="service-list" enhanced show-scrollbar="{{false}}">
      <view class="service-card" wx:for="{{filteredServices}}" wx:key="id" bindtap="onServiceTap" data-id="{{item.id}}">
        <view class="service-photo-wrap">
          <image class="car-photo" src="{{item.image}}" mode="aspectFill" />
        </view>

        <view class="service-info">
          <view class="service-title-row">
            <view class="title-wrap">
              <text class="service-name">{{item.name}}</text>
              <text class="service-edition">{{item.edition}}</text>
            </view>
            <view class="video-badge" wx:if="{{item.hasVideo}}">
              <text class="video-icon">▶</text>
            </view>
          </view>

          <text class="service-items">{{item.items}}</text>
          <text class="service-dimensions">尺寸：{{item.dimensions}}</text>
          <text class="service-price">¥{{item.price}}/{{item.unit}}</text>
        </view>
      </view>

      <view class="empty-state" wx:if="{{filteredServices.length === 0}}">
        <text class="empty-text">暂无该类别服务</text>
      </view>
      <view class="list-bottom-space"></view>
    </scroll-view>
  </view>

  <app-tabbar activeKey="service"></app-tabbar>
</view>
