.home-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #4a3724;
}

.page-bg,
.page-overlay {
  position: fixed;
  inset: 0;
}

.page-bg {
  width: 100%;
  height: 100%;
}

.page-overlay {
  background:
    linear-gradient(180deg, rgba(60, 33, 8, 0.18), rgba(47, 32, 18, 0.08) 18%, rgba(31, 34, 26, 0.22) 48%, rgba(23, 28, 21, 0.42) 100%),
    radial-gradient(circle at 50% 4%, rgba(255, 211, 150, 0.18), transparent 24%);
}

.top-shell {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
}

.brand-btn {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.brand-icon {
  width: 30rpx;
  height: 30rpx;
}

.search-box {
  flex: 1;
  height: 48rpx;
  padding: 0 18rpx 0 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 239, 0.44);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #fff;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.search-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.8;
}

.capsule-btn {
  position: fixed;
  width: 136rpx;
  height: 48rpx;
  border-radius: 26rpx;
  background: rgba(255, 247, 239, 0.72);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx;
  box-sizing: border-box;
  z-index: 4;
}

.capsule-dots {
  display: flex;
  gap: 6rpx;
  align-items: center;
}

.capsule-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #1d1d1d;
}

.capsule-split {
  width: 1rpx;
  height: 18rpx;
  background: rgba(0, 0, 0, 0.18);
}

.capsule-ring {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #1d1d1d;
  box-sizing: border-box;
}

.content-scroll {
  position: relative;
  z-index: 2;
  height: calc(100vh - 110rpx);
}

.section {
  margin-top: 18rpx;
}

.section-title {
  display: block;
  padding: 0 24rpx 18rpx;
  font-size: 22px;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.18);
}

.horizontal-scroll {
  white-space: nowrap;
}

.hero-row {
  display: flex;
  gap: 18rpx;
  padding: 0 16rpx;
}

.hero-card {
  position: relative;
  width: 640rpx;
  min-height: 402rpx;
  flex-shrink: 0;
  border-radius: 34rpx;
  padding: 18rpx;
  box-sizing: border-box;
  display: flex;
  gap: 16rpx;
  background: rgba(198, 210, 218, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow:
    0 18rpx 42rpx rgba(0, 0, 0, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.hero-card-single {
  width: auto;
  margin: 0 16rpx;
}

.hero-left {
  width: 286rpx;
  flex-shrink: 0;
}

.hero-left-rect {
  width: 248rpx;
}

.hero-image-shell {
  position: relative;
  width: 286rpx;
  height: 286rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.hero-image-shell-rect {
  width: 248rpx;
  height: 286rpx;
  border-radius: 24rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-price {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(125, 127, 131, 0.7);
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
}

.hero-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.hero-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.46);
}

.hero-dot-active {
  background: #fff;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 20px;
  line-height: 1.24;
  color: #fff;
  font-weight: 500;
}

.hero-meta {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.hero-meta-pill {
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.88);
  background: rgba(255, 255, 255, 0.18);
}

.hero-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.hero-tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.hero-tag {
  padding: 5rpx 14rpx;
  border-radius: 18rpx;
  font-size: 18rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
}

.hero-tag-pink {
  background: rgba(214, 143, 141, 0.7);
}

.hero-tag-gray {
  background: rgba(143, 151, 156, 0.66);
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.84);
  display: -webkit-box;
  -webkit-line-clamp: 7;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hero-footer {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.hero-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hero-badge-icon {
  width: 36rpx;
  height: 36rpx;
}

.hero-badge-text,
.hero-score,
.hero-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-subtitle {
  margin-top: auto;
}

.diy-card {
  position: relative;
  height: 212rpx;
  margin: 0 16rpx;
  border-radius: 30rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.18);
}

.diy-image,
.diy-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.diy-mask {
  background: linear-gradient(90deg, rgba(24, 26, 31, 0.8), rgba(34, 44, 53, 0.36) 60%, rgba(34, 44, 53, 0.12));
}

.diy-content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 26rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.diy-title {
  display: block;
  font-size: 20px;
  color: #fff;
  font-weight: 700;
}

.diy-text {
  display: block;
  width: 360rpx;
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.86);
}

.diy-btn {
  min-width: 174rpx;
  height: 58rpx;
  padding: 0 28rpx;
  border-radius: 29rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.08);
}

.login-bar {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 16rpx;
  height: 62rpx;
  border-radius: 31rpx;
  background: rgba(31, 42, 43, 0.88);
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.login-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.login-copy-icon {
  width: 30rpx;
  height: 30rpx;
}

.login-copy-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.login-btn {
  width: 140rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #95f4f1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #133235;
  font-size: 22rpx;
  font-weight: 700;
}

.login-close {
  width: 34rpx;
  margin-left: 12rpx;
  text-align: center;
  font-size: 34rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.62);
}

.scroll-bottom-space {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.bottom-nav {
  position: fixed;
  left: 50rpx;
  right: 50rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 106rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 48rpx;
  background: rgba(31, 48, 60, 0.7);
  box-shadow:
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.18),
    0 10rpx 26rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  z-index: 5;
}

.bottom-nav-item {
  width: 108rpx;
  height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bottom-nav-icon {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.62;
}

.bottom-nav-text {
  display: none;
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.bottom-nav-item.active .bottom-nav-icon {
  opacity: 1;
}

.bottom-nav-item.active .bottom-nav-text {
  display: block;
  color: #78f3ee;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 520rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: rgba(32, 37, 43, 0.96);
  box-sizing: border-box;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.modal-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.74);
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.modal-btn-ghost {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
}

.modal-btn-primary {
  background: #95f4f1;
  color: #133235;
  font-weight: 700;
}
