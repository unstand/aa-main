/* pages/home/home.wxss */
@font-face {
  font-family: "HarmonyOS Sans";
  src: url("/ttf/HarmonyOS Sans.ttf");
  font-family: "Alimama FangYuanTi VF";
  src: url("/ttf/Alimama FangYuanTi VF.ttf");
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.18);
  z-index: 1;
  pointer-events: none;
}

.home-page {
  position: relative;
  z-index: 2;
  min-height: 100vh;

}



/* ===== 搜索栏 ===== */
.search-bar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  padding-top: calc(88rpx + env(safe-area-inset-top));
  padding-bottom: 20rpx;
  z-index: 10;
  /* ❌ 删除背景 */
  background: transparent;

  /* ❌ 删除毛玻璃 */
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.moon-logo {
  width: 30px;
  height: 29px;
  top: 8.67px;
  left: 18px;
  z-index: 10;
}

.search-inner {
  width: 177px;
  height: 26px;

  top: 8.67px;
  left: 100px;

  display: flex;
  align-items: center;
  background-color: rgba(255, 251, 246, 0.5);
  border-radius: 26rpx;
  padding: 0 24rpx;
}

.search-input {
  flex: 1;
  font-size: 22rpx;
  color: #ffffff;
  font-family: "HarmonyOS Sans";
  font-weight: 300;
  min-width: 0;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  opacity: 0.6;
  flex-shrink: 0;
}

.content-scroll {
  height: calc(100vh - 100rpx);
}

.scroll-bottom-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

/* 区块标题 */
.section {
  margin-bottom: 28rpx;
}

.section-header {
  padding: 16rpx 32rpx 12rpx;
}

.section-title {
  font-family: "Alimama FangYuanTi VF";
  font-weight: 700;
  font-size: 18px;
  line-height: 22px;
  color: rgba(255, 255, 255, 1);
}

/* 横向滚动 */
.plan-scroll {
  white-space: nowrap;
}

.plan-cards {
  display: flex;
  padding: 0 32rpx;
  gap: 20rpx;
}

/* 玻璃拟态计划卡片 */
.glass-plan-card {
  position: relative;
  width: 620rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.central-asia-card {
  width: auto;
  margin: 0 32rpx;
}

.plan-card-inner {
  display: flex;
  align-items: stretch;
  padding: 20rpx;
  gap: 16rpx;
}

/* 左侧：封面 + 标题 + 分页点 */
.plan-left {
  width: 220rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.plan-image-wrap {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
}

.plan-image-wrap-vertical {
  width: 196rpx;
  height: 240rpx;
  border-radius: 20rpx;
}

.plan-image {
  width: 100%;
  height: 100%;
}

.plan-price-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(80, 80, 90, 0.72);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.price-text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 500;
  white-space: nowrap;
}

.plan-card-title {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
  white-space: normal;
}

.plan-meta-row {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.meta-tag {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.12);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

.carousel-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  justify-content: center;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
}

.dot-active {
  background: rgba(255, 255, 255, 0.95);
}

/* 右侧：标签 + 描述 + 季节 */
.plan-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-top: 4rpx;
}

.plan-tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.feature-tag {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.feature-tag-0 {
  background: rgba(255, 140, 160, 0.35);
  color: #ffe8ec;
}

.feature-tag-1 {
  background: rgba(120, 190, 255, 0.35);
  color: #e8f4ff;
}

.feature-tag-2 {
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.82);
}

.plan-desc-text {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
}

.plan-season {
  margin-top: auto;
  padding-top: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  text-align: right;
}

/* 中亚游底部登录浮层 */
.login-float-bar {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 16rpx 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(20, 20, 30, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.login-float-text {
  flex: 1;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.4;
  white-space: normal;
}

.login-float-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #4ecdc4;
}

.login-float-btn-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.login-float-close {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-float-close-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* DIY 定制卡片 */
.diy-card {
  position: relative;
  margin: 0 32rpx;
  height: 160rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  background: linear-gradient(135deg, #4a6078 0%, #2a3548 100%);
}

.diy-bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.diy-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(90deg,
      rgba(10, 15, 25, 0.78) 0%,
      rgba(10, 15, 25, 0.45) 55%,
      rgba(10, 15, 25, 0.15) 100%);
}

.diy-row {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  gap: 20rpx;
}

.diy-desc {
  flex: 1;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.55;
  white-space: normal;
}

.diy-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.diy-btn-text {
  font-size: 22rpx;
  color: #ffffff;
  white-space: nowrap;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 544rpx;
  background-color: #2d2d44;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #8e8e9a;
  display: block;
  margin-bottom: 32rpx;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
}

.modal-cancel {
  flex: 1;
  padding: 20rpx 0;
}

.modal-confirm {
  flex: 1;
  padding: 20rpx 0;
}

.bottom-nav {
  position: fixed;
  left: 50rpx;
  right: 50rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 30;
  height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 48rpx;
  background: rgba(44, 52, 39, 0.62);
  box-shadow:
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.18),
    0 10rpx 26rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.bottom-nav-item {
  width: 108rpx;
  height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bottom-nav-icon {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.62;
}

.bottom-nav-text {
  display: none;
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.bottom-nav-item.active .bottom-nav-icon {
  opacity: 1;
}

.bottom-nav-item.active .bottom-nav-text {
  display: block;
  color: #78f3ee;
}