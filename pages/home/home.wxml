<view class="home-page">
  <image class="page-bg" src="/images/home-bj.png" mode="aspectFill"></image>
  <view class="page-overlay"></view>

  <view class="top-shell" style="{{topShellStyle}}">
    <view class="brand-btn">
      <image class="brand-icon" src="/images/logo.png" mode="aspectFit"></image>
    </view>
    <view class="search-box">
      <input
        class="search-input"
        placeholder="你有什么计划？"
        placeholder-class="search-placeholder"
        bindinput="onSearchInput"
        value="{{searchKeyword}}"
      />
      <image class="search-icon" src="/images/sousuo.png" mode="aspectFit"></image>
    </view>
    <view class="capsule-btn" style="{{capsuleStyle}}" bindtap="onMoreMenu">
      <view class="capsule-dots">
        <view class="capsule-dot"></view>
        <view class="capsule-dot"></view>
        <view class="capsule-dot"></view>
      </view>
      <view class="capsule-split"></view>
      <view class="capsule-ring"></view>
    </view>
  </view>

  <scroll-view scroll-y class="content-scroll" show-scrollbar="{{false}}">
    <view class="section">
      <text class="section-title">当季热门计划：</text>
      <scroll-view scroll-x class="horizontal-scroll" show-scrollbar="{{false}}">
        <view class="hero-row">
          <view
            class="hero-card"
            wx:for="{{plans}}"
            wx:key="id"
            bindtap="onPlanTap"
            data-id="{{item.id}}"
          >
            <view class="hero-left">
              <view class="hero-image-shell">
                <image class="hero-image" src="{{item.image}}" mode="aspectFill"></image>
                <view class="hero-price">¥{{item.price}}/{{item.unit}}</view>
              </view>
              <view class="hero-dots">
                <view class="hero-dot hero-dot-active"></view>
                <view class="hero-dot"></view>
                <view class="hero-dot"></view>
              </view>
              <text class="hero-title">{{item.displayTitle}}</text>
              <view class="hero-meta">
                <text class="hero-meta-pill">{{item.days}}天{{item.nights}}晚</text>
                <text class="hero-meta-pill">{{item.distance}}</text>
              </view>
            </view>
            <view class="hero-right">
              <view class="hero-tag-grid">
                <text
                  class="hero-tag {{tagIndex < 2 ? 'hero-tag-pink' : 'hero-tag-gray'}}"
                  wx:for="{{item.tags}}"
                  wx:for-item="tag"
                  wx:for-index="tagIndex"
                  wx:key="tagIndex"
                >{{tag}}</text>
              </view>
              <text class="hero-desc">{{item.description}}</text>
              <view class="hero-footer">
                <view class="hero-badge">
                  <image class="hero-badge-icon" src="/images/logo.png" mode="aspectFit"></image>
                  <text class="hero-badge-text">匿召</text>
                </view>
                <text class="hero-score">{{item.rating}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="section">
      <text class="section-title">DIY定制计划：</text>
      <view class="diy-card" bindtap="onGoDIY">
        <image class="diy-image" src="/images/login-bj.png" mode="aspectFill"></image>
        <view class="diy-mask"></view>
        <view class="diy-content">
          <view>
            <text class="diy-title">DIY定制计划：</text>
            <text class="diy-text">在游玩中根据自己的喜好定制目的地，车辆及领队及额外服务，</text>
          </view>
          <view class="diy-btn">前往定制</view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">中亚游：</text>
      <view
        class="hero-card hero-card-single"
        wx:for="{{centralAsiaPlans}}"
        wx:key="id"
        bindtap="onCentralAsiaTap"
        data-id="{{item.id}}"
      >
        <view class="hero-left hero-left-rect">
          <view class="hero-image-shell hero-image-shell-rect">
            <image class="hero-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="hero-price">¥{{item.price}}/{{item.unit}}</view>
          </view>
          <view class="hero-dots">
            <view class="hero-dot hero-dot-active"></view>
            <view class="hero-dot"></view>
            <view class="hero-dot"></view>
          </view>
          <text class="hero-title">{{item.displayTitle}}</text>
          <view class="hero-meta">
            <text class="hero-meta-pill">{{item.days}}天{{item.nights}}晚</text>
            <text class="hero-meta-pill">{{item.distance}}</text>
          </view>
        </view>
        <view class="hero-right">
          <view class="hero-tag-grid">
            <text
              class="hero-tag {{tagIndex < 2 ? 'hero-tag-pink' : 'hero-tag-gray'}}"
              wx:for="{{item.tags}}"
              wx:for-item="tag"
              wx:for-index="tagIndex"
              wx:key="tagIndex"
            >{{tag}}</text>
          </view>
          <text class="hero-desc">{{item.description}}</text>
          <text class="hero-subtitle">{{item.subtitle}}</text>
        </view>

        <view class="login-bar" wx:if="{{showLoginBar && !isLoggedIn}}">
          <view class="login-copy">
            <image class="login-copy-icon" src="/images/logo.png" mode="aspectFit"></image>
            <text class="login-copy-text">登录开启私域定制的旅行计划</text>
          </view>
          <view class="login-btn" bindtap="onGoLogin">立即登录</view>
          <view class="login-close" catchtap="onCloseLoginBar">×</view>
        </view>
      </view>
    </view>

    <view class="scroll-bottom-space"></view>
  </scroll-view>

  <app-tabbar activeKey="home"></app-tabbar>

  <view class="modal-mask" wx:if="{{showLoginModal}}" bindtap="onCloseLoginModal">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">需要登录</text>
      <text class="modal-desc">请先登录后查看详细计划</text>
      <view class="modal-actions">
        <view class="modal-btn modal-btn-ghost" bindtap="onCloseLoginModal">取消</view>
        <view class="modal-btn modal-btn-primary" bindtap="onGoLogin">去登录</view>
      </view>
    </view>
  </view>
</view>
