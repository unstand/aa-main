page {
  height: 100%;
  background: #55606f;
}

.detail-page {
  position: relative;
  min-height: 100vh;
  color: #131313;
  overflow: hidden;
}

.page-bg,
.page-mask,
.page-frost {
  position: fixed;
  inset: 0;
}

.page-bg {
  width: 100%;
  height: 100%;
}

.page-mask {
  background:
    linear-gradient(180deg, rgba(122, 133, 148, 0.82) 0%, rgba(114, 118, 128, 0.28) 16%, rgba(31, 22, 30, 0.3) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(0, 0, 0, 0.14));
}

.page-frost {
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.status-bar {
  height: calc(44rpx + env(safe-area-inset-top));
}

.top-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx 10rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(49, 69, 93, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.nav-back-icon {
  color: #edf1f6;
  font-size: 46rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-actions {
  height: 48rpx;
  min-width: 148rpx;
  padding: 0 18rpx;
  border-radius: 26rpx;
  background: rgba(229, 232, 236, 0.72);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.nav-dots {
  color: #0e1116;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.nav-split {
  width: 1rpx;
  height: 26rpx;
  background: rgba(0, 0, 0, 0.16);
}

.nav-circle {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 4rpx solid #0e1116;
  box-sizing: border-box;
}

.content-scroll {
  position: relative;
  z-index: 2;
  height: calc(100vh - 120rpx);
  padding: 16rpx 28rpx 0;
  box-sizing: border-box;
}

.glass-card {
  position: relative;
  background: rgba(248, 242, 240, 0.74);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 32rpx;
  box-shadow:
    0 18rpx 40rpx rgba(11, 16, 25, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

.hero-card {
  padding: 22rpx;
  margin-bottom: 28rpx;
}

.hero-image-wrap {
  position: relative;
  height: 332rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.media-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #96edf0;
  color: #101217;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.hero-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}

.hero-dot.active {
  background: #ffffff;
}

.vehicle-summary {
  padding: 22rpx 10rpx 0;
}

.title-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.vehicle-name {
  font-size: 30rpx;
  line-height: 1.2;
  color: #101010;
  font-weight: 700;
}

.vehicle-year {
  font-size: 20rpx;
  color: #6f7884;
}

.vehicle-specs {
  display: block;
  font-size: 20rpx;
  line-height: 1.5;
  color: #687181;
}

.booking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0 14rpx;
}

.quantity-box {
  width: 318rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: rgba(189, 191, 199, 0.36);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.quantity-label {
  font-size: 22rpx;
  color: #7f8792;
  margin-right: 34rpx;
}

.quantity-action {
  width: 52rpx;
  text-align: center;
  font-size: 40rpx;
  line-height: 1;
  color: #4d5868;
}

.quantity-action.disabled {
  opacity: 0.4;
}

.quantity-value {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #16171a;
  font-weight: 700;
}

.price-text {
  font-size: 34rpx;
  color: #425063;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.date-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(191, 194, 201, 0.34);
}

.date-col {
  min-width: 176rpx;
}

.date-col-right {
  text-align: right;
}

.date-main-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-col-right .date-main-row {
  justify-content: flex-end;
}

.date-main {
  font-size: 28rpx;
  color: #111214;
  font-weight: 700;
}

.date-arrow {
  font-size: 18rpx;
  color: #536173;
}

.date-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #6f7885;
}

.date-center {
  font-size: 20rpx;
  color: #697280;
}

.location-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.location-card {
  border-radius: 22rpx;
  background: rgba(191, 194, 201, 0.34);
  padding: 18rpx 22rpx;
  box-sizing: border-box;
}

.city-card {
  width: 180rpx;
}

.location-card-wide {
  flex: 1;
}

.location-label {
  display: block;
  font-size: 22rpx;
  color: #78818e;
  margin-bottom: 18rpx;
}

.location-value {
  display: block;
  font-size: 22rpx;
  color: #131313;
  font-weight: 700;
  line-height: 1.3;
}

.info-card,
.insurance-card {
  padding: 26rpx 24rpx 22rpx;
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  color: #111214;
  font-weight: 700;
}

.section-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-link-text,
.section-link-arrow {
  font-size: 22rpx;
  color: #687385;
}

.add-driver {
  height: 74rpx;
  margin: 28rpx 0;
  border-radius: 20rpx;
  background: rgba(191, 194, 201, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-driver-icon,
.add-driver-text {
  font-size: 22rpx;
  color: #667282;
  font-weight: 600;
}

.material-row {
  display: flex;
  align-items: flex-start;
}

.material-title {
  width: 72rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #647081;
  font-weight: 700;
}

.material-divider {
  width: 2rpx;
  height: 74rpx;
  background: rgba(87, 100, 119, 0.5);
  margin: 4rpx 18rpx 0 6rpx;
}

.material-list {
  flex: 1;
}

.material-item {
  display: block;
  font-size: 20rpx;
  line-height: 1.7;
  color: #687181;
}

.insurance-head {
  margin-bottom: 22rpx;
}

.insurance-head-left {
  display: flex;
  align-items: baseline;
}

.insurance-provider {
  margin-left: 6rpx;
  font-size: 18rpx;
  color: #858e9a;
}

.insurance-table {
  display: flex;
  border-radius: 24rpx;
  background: rgba(191, 194, 201, 0.28);
  overflow: hidden;
}

.insurance-label-col {
  width: 148rpx;
  padding: 18rpx 0 18rpx 16rpx;
  box-sizing: border-box;
}

.table-head-spacer {
  height: 78rpx;
  font-size: 22rpx;
  color: #637080;
  display: flex;
  align-items: center;
}

.label-cell {
  min-height: 128rpx;
  padding-top: 18rpx;
  font-size: 22rpx;
  color: #5f6c7d;
  line-height: 1.4;
}

.insurance-plan-col {
  flex: 1;
  position: relative;
  padding: 10rpx 16rpx 18rpx;
  border-left: 1rpx solid rgba(84, 97, 116, 0.14);
  box-sizing: border-box;
}

.insurance-plan-col.selected {
  border: 2rpx solid #89f3f5;
  border-radius: 24rpx;
  margin: 4rpx 0;
  background: rgba(255, 255, 255, 0.08);
}

.plan-head {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.plan-name {
  font-size: 22rpx;
  color: #495667;
  font-weight: 700;
}

.plan-arrow {
  font-size: 20rpx;
  color: #556376;
}

.plan-cell {
  min-height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4rpx;
  text-align: center;
}

.plan-cell-text {
  font-size: 20rpx;
  line-height: 1.45;
  color: #627080;
  white-space: pre-line;
}

.insurance-plan-col.selected .plan-name,
.insurance-plan-col.selected .plan-arrow,
.insurance-plan-col.selected .plan-cell-text {
  color: #546273;
}

.plan-select {
  width: 122rpx;
  height: 48rpx;
  margin: 8rpx auto 0;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-select.active {
  border-color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.08);
}

.plan-select-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 700;
}

.bottom-space {
  height: 180rpx;
}

.bottom-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  padding: 0 24rpx calc(18rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  height: 98rpx;
  padding: 12rpx;
  border-radius: 32rpx;
  background: rgba(35, 42, 56, 0.86);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  box-shadow:
    0 16rpx 36rpx rgba(5, 10, 18, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  box-sizing: border-box;
}

.total-box {
  width: 178rpx;
  height: 100%;
  padding-left: 18rpx;
  border-radius: 24rpx;
  background: rgba(20, 26, 38, 0.95);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.total-label,
.total-value {
  font-size: 22rpx;
  color: #83edf0;
  font-weight: 700;
}

.action-btn {
  height: 100%;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.contact-btn {
  width: 170rpx;
  margin-left: 12rpx;
  background: #8ceef0;
  color: #111214;
}

.primary-btn {
  flex: 1;
  margin-left: 12rpx;
  background: #8ceef0;
  color: #111214;
  gap: 8rpx;
}

.primary-free {
  font-size: 18rpx;
  font-style: italic;
  font-weight: 700;
}

.primary-text {
  font-size: 24rpx;
  font-weight: 700;
}
