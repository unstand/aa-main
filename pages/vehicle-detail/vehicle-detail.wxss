/* pages/vehicle-detail/vehicle-detail.wxss */
.detail-page {
  min-height: 100vh;
  background-color: #1a1a2e;
}

.content-scroll {
  height: calc(100vh - 120rpx);
  padding: 20rpx 40rpx;
  box-sizing: border-box;
}

/* ===== 车辆信息 ===== */
.vehicle-section {
  background-color: rgba(45, 45, 68, 0.7);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.vehicle-img-wrap {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  position: relative;
  box-sizing: border-box;
}

.vehicle-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #3d3d5c, #2a2a44);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vehicle-icon {
  font-size: 100rpx;
  opacity: 0.5;
}

.video-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(78, 205, 196, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-icon {
  font-size: 24rpx;
  color: #ffffff;
}

.vehicle-info {
  margin-bottom: 20rpx;
}

.vehicle-name {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
  font-family: "HarmonyOS Sans";
}

.vehicle-specs {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
}

/* 数量价格 */
.quantity-price-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.quantity-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-right: 20rpx;
}

.quantity-selector {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: rgba(61, 61, 92, 0.8);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.qty-btn.disabled {
  opacity: 0.3;
}

.quantity-value {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
  min-width: 40rpx;
  text-align: center;
}

.unit-price {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 700;
  margin-left: auto;
  font-family: "HarmonyOS Sans";
}

/* 日期选择 */
.date-section {
  background-color: rgba(35, 35, 64, 0.6);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-item-right {
  justify-content: flex-end;
}

.date-value {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.date-arrow {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.4);
}

.date-duration {
  padding: 6rpx 16rpx;
  background-color: rgba(78, 205, 196, 0.12);
  border-radius: 16rpx;
}

.duration-text {
  font-size: 22rpx;
  color: #4ecdc4;
}

/* 地点 */
.location-section {
  background-color: rgba(35, 35, 64, 0.6);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.location-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.location-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  width: 120rpx;
}

.location-value {
  font-size: 24rpx;
  color: #ffffff;
}

/* ===== 驾驶员 ===== */
.driver-section {
  background-color: rgba(45, 45, 68, 0.7);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.section-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  font-family: "HarmonyOS Sans";
}

.view-all-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

.add-driver-btn {
  border: 2rpx dashed rgba(255, 255, 255, 0.15);
  border-radius: 14rpx;
  padding: 28rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.add-driver-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

.driver-notice {
  background-color: rgba(35, 35, 64, 0.6);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.notice-title {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  display: block;
  margin-bottom: 6rpx;
}

.notice-item {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  display: block;
  line-height: 1.6;
}

/* ===== 保险 ===== */
.insurance-section {
  background-color: rgba(45, 45, 68, 0.7);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.insurance-title-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.insurance-provider {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.insurance-table {
  width: 100%;
}

.table-row {
  display: flex;
  margin-bottom: 2rpx;
}

.table-header {
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.table-cell {
  flex: 1;
  padding: 10rpx 6rpx;
  text-align: center;
}

.cell-label {
  flex: 0.7;
  text-align: left;
}

.cell-label-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.plan-name {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
  display: block;
  font-family: "HarmonyOS Sans";
}

.table-cell.selected .plan-name {
  color: #4ecdc4;
}

.cell-value-text {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.5;
}

.table-cell.selected .cell-value-text {
  color: rgba(78, 205, 196, 0.8);
}

/* 费用行 */
.table-cost-row {
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
  margin-top: 4rpx;
}

.cell-cost-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 500;
}

.table-cell.selected .cell-cost-text {
  color: #4ecdc4;
  font-weight: 600;
}

.cell-btn {
  padding-top: 12rpx;
}

.select-btn {
  display: inline-block;
  padding: 10rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
}

.select-btn.active {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  border-color: #4ecdc4;
}

.select-btn-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.select-btn.active .select-btn-text {
  color: #ffffff;
  font-weight: 500;
}

.safe-bottom {
  height: 140rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: rgba(30, 30, 50, 0.95);
  backdrop-filter: blur(12px);
  z-index: 100;
}

.bar-price {
  display: flex;
  align-items: baseline;
}

.bar-price-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.bar-price-value {
  font-size: 38rpx;
  color: #ffffff;
  font-weight: 700;
  font-family: "HarmonyOS Sans";
}

.bar-actions {
  display: flex;
  gap: 16rpx;
}

.bar-btn {
  padding: 16rpx 36rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-btn text {
  font-size: 26rpx;
  color: #ffffff;
  white-space: nowrap;
  font-weight: 500;
  font-family: "HarmonyOS Sans";
}

.bar-btn-contact {
  background-color: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.bar-btn-action {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
}
