
.dou{
  position:absolute;
  top: 12rpx;
  right: 12rpx;
  display: block;
  text-align: right;
  border-radius: 40%;
  width: 50rpx;
  height: 50rpx;
  background-color: rgba(147, 238, 238, 1);
  display: flex;
  justify-content: center;
  align-items: center;
}
.douyin{
  width: 21rpx;
  height: 23.5rpx;
  display: block;
}
.detail-page {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  background-color: transparent;
}
.page-bg {
  position: fixed;
  width: 100%;
  height: 100%;
  opacity: 0.76;
  z-index: 0;
}

.bg-mask {
  position: fixed;
  width: 100%;
  height: 100%;
  z-index: 1;
  background:
    linear-gradient(90deg, rgba(11, 12, 16, 0.58) 0%, rgba(13, 13, 15, 0.2) 48%, rgba(26, 22, 20, 0.22) 100%),
    rgba(17, 21, 27, 0.22);
}



.content-scroll {
  position: relative;
  z-index: 2;
  height: calc(100vh - 162rpx);
  padding: 22rpx 30rpx 0;
  box-sizing: border-box;
}
.top-bar {
  position: relative;
  display: flex;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  padding-bottom: 20rpx;
  z-index: 10;
    /* ❌ 删除背景 */
    background: transparent;

    /* ❌ 删除毛玻璃 */
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
}
.back-btn {
  position: relative;

  width: 64rpx;
  height: 64rpx;

  border-radius: 16rpx;
  z-index: 9999;
 background-color: rgba(17, 34, 52, 0.67);
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-arrow {
  width: 20rpx;
  height: 20rpx;

  border-left: 4rpx solid rgba(203, 202, 202, 1);
  border-bottom: 4rpx solid rgba(203, 202, 202, 1);

  transform: rotate(45deg);

  margin-left: 8rpx;
}

.glass-card {
  background: rgba(247, 241, 237, 0.74);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 32rpx;
  flex: 1;
  min-height: 800rpx;
  box-shadow:
    0 18rpx 42rpx rgba(7, 12, 20, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.36);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.hero-card {
  padding: 18rpx 18rpx 20rpx;
}

.hero-image-wrap {
  position: relative;
  height: 340rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background:transparent;
}

.hero-image {
  width: 100%;
  height: 100%;
  transform: scale(1.18);
}

.media-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
