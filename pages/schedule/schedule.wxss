/* pages/schedule/schedule.wxss */
.schedule-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* ===== 背景 ===== */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.page-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(10, 10, 20, 0.72);
  backdrop-filter: blur(20px);
  z-index: 1;
}

/* ===== 顶部内容 ===== */
.top-content {
  position: relative;
  z-index: 2;
  padding-top: calc(88rpx + env(safe-area-inset-top));
  padding-left: 40rpx;
  padding-right: 40rpx;
}

/* ===== 用户信息 ===== */
.profile {
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

.user-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  font-family: "HarmonyOS Sans";
}

.user-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
  font-family: "HarmonyOS Sans";
}

/* ===== 标签页 ===== */
.tabs {
  display: flex;
  gap: 48rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tab-item {
  position: relative;
  padding-bottom: 16rpx;
}

.tab-item text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  font-family: "HarmonyOS Sans";
}

.tab-item.active text {
  color: #ffffff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #4ecdc4;
  border-radius: 2rpx;
}

/* ===== 计划列表 ===== */
.plan-scroll {
  position: relative;
  z-index: 2;
  height: calc(100vh - 320rpx);
  padding: 24rpx 40rpx 0;
}

/* ===== 计划卡片 ===== */
.plan-card {
  display: flex;
  background-color: rgba(30, 30, 50, 0.65);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

/* 左侧封面 */
.cover-wrap {
  width: 190rpx;
  min-height: 260rpx;
  position: relative;
  flex-shrink: 0;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.55) 100%);
}

/* 锁图标 */
.lock-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}

.lock-ring {
  width: 28rpx;
  height: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.7);
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
}

.lock-body {
  width: 36rpx;
  height: 26rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 4rpx;
}

/* 金额标签 */
.price-pill {
  position: absolute;
  top: 16rpx;
  left: 12rpx;
  z-index: 3;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.price-pill text {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.88);
  white-space: nowrap;
}

/* 封面底部 */
.cover-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 10rpx 12rpx;
  z-index: 3;
}

.cover-title {
  display: block;
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 500;
  line-height: 1.3;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cover-tags {
  display: flex;
  gap: 8rpx;
}

.cover-tag {
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  background: rgba(0, 0, 0, 0.35);
  color: rgba(255, 255, 255, 0.8);
  font-size: 14rpx;
  line-height: 1.5;
}

/* 右侧详情 */
.card-content {
  flex: 1;
  padding: 16rpx 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-line {
  font-size: 18rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.6);
  font-family: "HarmonyOS Sans";
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 操作按钮 */
.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 12rpx;
}

.action-btn {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn text {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
  white-space: nowrap;
  font-family: "HarmonyOS Sans";
}

.action-btn.ghost {
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.05);
}

.action-btn.primary {
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  border: 1rpx solid rgba(78, 205, 196, 0.5);
}

.action-btn.primary text {
  color: #ffffff;
  font-weight: 500;
}

.empty-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.bottom-nav {
  position: fixed;
  left: 50rpx;
  right: 50rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 30;
  height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid rgba(156, 95, 255, 0.76);
  border-radius: 48rpx;
  background: rgba(54, 42, 61, 0.64);
  box-shadow:
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.18),
    0 10rpx 26rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.bottom-nav-item {
  width: 108rpx;
  height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bottom-nav-icon {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.62;
}

.bottom-nav-text {
  display: none;
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: rgba(255, 255, 255, 0.62);
}

.bottom-nav-item.active .bottom-nav-icon {
  opacity: 1;
}

.bottom-nav-item.active .bottom-nav-text {
  display: block;
  color: #78f3ee;
}
