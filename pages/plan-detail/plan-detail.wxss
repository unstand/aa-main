.plan-detail-page {
  position: relative;
  min-height: 100vh;
  background: #3c4b5f;
  overflow: hidden;
}

.page-bg,
.page-mask,
.page-frost {
  position: fixed;
  inset: 0;
}

.page-bg {
  width: 100%;
  height: 100%;
}

.page-mask {
  background:
    linear-gradient(180deg, rgba(77, 93, 112, 0.88) 0%, rgba(52, 68, 89, 0.68) 26%, rgba(28, 35, 47, 0.72) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(0, 0, 0, 0.12));
}

.page-frost {
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.loading-wrap,
.error-wrap {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-text,
.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.retry-btn {
  padding: 18rpx 42rpx;
  border-radius: 999rpx;
  background: #8ceef0;
  color: #111214;
  font-size: 26rpx;
  font-weight: 700;
}

.status-bar {
  position: relative;
  z-index: 2;
  height: calc(44rpx + env(safe-area-inset-top));
}

.top-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 6rpx;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: rgba(45, 63, 85, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 32rpx;
  color: #eef3f8;
  line-height: 1;
}

.nav-actions {
  height: 34rpx;
  min-width: 112rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  background: rgba(234, 236, 239, 0.72);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-dots {
  font-size: 22rpx;
  color: #101217;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-split {
  width: 1rpx;
  height: 18rpx;
  background: rgba(0, 0, 0, 0.14);
}

.nav-circle {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 3rpx solid #111318;
  box-sizing: border-box;
}

.content-scroll {
  position: relative;
  z-index: 2;
  height: calc(100vh - 112rpx);
  padding: 8rpx 0 0;
  box-sizing: border-box;
}

.hero-swiper-section {
  padding: 2rpx 0 10rpx;
}

.hero-swiper {
  height: 388rpx;
}

.hero-swiper-item {
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  transform: scale(0.88);
  opacity: 0.76;
  filter: saturate(0.92);
}

.hero-swiper-item.active {
  transform: scale(1);
  opacity: 1;
  filter: none;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.intro-section {
  padding: 0 30rpx 16rpx;
}

.intro-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.25;
  color: #ffffff;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.intro-line {
  display: block;
  font-size: 16rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.72);
}

.glass-card {
  margin: 0 28rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(233, 234, 236, 0.24);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}

.booking-card {
  padding: 16rpx;
}

.booking-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.guest-control {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.booking-label,
.booking-price,
.date-main,
.date-sub,
.date-center,
.location-value,
.resource-title,
.resource-price,
.resource-sub,
.location-label {
  color: #111214;
}

.booking-label,
.location-label {
  font-size: 18rpx;
  opacity: 0.52;
}

.booking-price {
  font-size: 30rpx;
  font-weight: 700;
}

.mini-stepper {
  width: 130rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(32, 45, 60, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.mini-stepper-btn,
.mini-stepper-value {
  font-size: 18rpx;
  color: #424f60;
  font-weight: 700;
}

.booking-dates {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.38);
}

.date-col {
  min-width: 120rpx;
}

.date-col-right {
  text-align: right;
}

.date-main {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
}

.date-sub,
.date-center {
  font-size: 16rpx;
  opacity: 0.52;
}

.date-sub {
  margin-top: 6rpx;
  display: block;
}

.booking-location {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.location-card {
  width: 126rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.34);
  box-sizing: border-box;
}

.location-card-wide {
  flex: 1;
}

.location-value {
  display: block;
  margin-top: 10rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.map-card {
  position: relative;
  margin: 0 28rpx 18rpx;
  height: 134rpx;
  border-radius: 22rpx;
  overflow: hidden;
}

.map-image {
  width: 100%;
  height: 100%;
}

.map-pin {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #97eef1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-pin-icon {
  font-size: 18rpx;
  color: #101217;
}

.resource-card {
  padding: 14rpx 16rpx 16rpx;
}

.resource-top {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.resource-copy {
  flex: 1;
}

.resource-title {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.resource-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 14rpx;
  line-height: 1.5;
  opacity: 0.6;
}

.resource-media-badge {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #97eef1;
  color: #111214;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
}

.resource-action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 14rpx 0 10rpx;
}

.resource-price {
  flex: 1;
  font-size: 20rpx;
  font-weight: 700;
}

.outline-btn {
  min-width: 82rpx;
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(66, 79, 96, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.outline-btn text {
  font-size: 16rpx;
  color: #425060;
}
.resource-image-shell {
  height: 126rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.74);
  display: flex;
  align-items: center;
  justify-content: center;
}

.resource-image {
  width: 92%;
  height: 108rpx;
}

.tab-section {
  margin: 0 14rpx 24rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(90, 107, 127, 0.92), rgba(56, 70, 88, 0.94)),
    rgba(70, 84, 103, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.tab-bar {
  display: flex;
  justify-content: space-around;
  padding: 18rpx 24rpx 0;
}

.tab-item {
  position: relative;
  padding: 6rpx 0 20rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.tab-active {
  color: #ffffff;
  font-weight: 700;
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #8fe9eb;
}

.tab-panel {
  padding: 10rpx 22rpx 26rpx;
}

.activity-poster {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
}

.activity-poster-image {
  display: block;
  width: 100%;
}

.poster-float {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  pointer-events: none;
}

.poster-top {
  top: 34rpx;
}

.poster-bottom {
  bottom: 26rpx;
}

.poster-title {
  display: block;
  font-size: 54rpx;
  line-height: 1.02;
  color: #ffffff;
  font-weight: 700;
  text-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.28);
}

.poster-title-second {
  margin-top: 6rpx;
}

.poster-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(78, 213, 65, 0.88);
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 700;
}

.poster-meta-row {
  display: flex;
  gap: 10rpx;
  justify-content: center;
}

.poster-meta {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 16rpx;
  color: #465567;
  font-weight: 700;
}

.schedule-day {
  margin-bottom: 34rpx;
}

.schedule-day:last-child {
  margin-bottom: 0;
}

.schedule-day-header {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 18rpx;
}

.schedule-day-num {
  width: 82rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.schedule-day-title {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.45;
  color: #ffffff;
  font-weight: 700;
}

.schedule-period {
  display: flex;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.period-left {
  width: 92rpx;
  display: flex;
  justify-content: space-between;
  flex-shrink: 0;
}

.period-time {
  width: 56rpx;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 700;
}

.period-marker-wrap {
  width: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.period-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffc20e;
  box-sizing: border-box;
}

.period-icon-ring {
  background: transparent;
  border: 4rpx solid #ffc20e;
}

.period-line {
  width: 2rpx;
  height: 112rpx;
  margin-top: 6rpx;
  background: rgba(255, 255, 255, 0.14);
}

.schedule-period:last-child .period-line {
  display: none;
}

.period-content {
  flex: 1;
}

.period-item {
  display: block;
  font-size: 18rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.9);
}

.schedule-transport {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-left: 90rpx;
}

.transport-icon {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(255, 194, 14, 0.22);
  color: #ffc20e;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.transport-text {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.72);
}

.fee-section {
  margin-bottom: 28rpx;
}

.fee-section:last-child {
  margin-bottom: 0;
}

.fee-section-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.fee-section-title {
  font-size: 22rpx;
  line-height: 1.25;
  color: #ffffff;
  font-weight: 700;
}

.fee-section-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 4rpx solid #ffc20e;
  box-sizing: border-box;
}

.fee-section-item {
  display: block;
  font-size: 17rpx;
  line-height: 1.72;
  color: rgba(255, 255, 255, 0.82);
  white-space: pre-wrap;
}

.bottom-space {
  height: 170rpx;
}

.bottom-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  padding: 0 14rpx calc(16rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  height: 86rpx;
  padding: 8rpx;
  border-radius: 30rpx;
  background: rgba(30, 40, 54, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.total-box {
  width: 134rpx;
  height: 100%;
  padding-left: 16rpx;
  border-radius: 22rpx;
  background: rgba(18, 26, 39, 0.98);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.total-label,
.total-value {
  font-size: 18rpx;
  color: #8decef;
  font-weight: 700;
}

.action-btn {
  height: 100%;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.contact-btn {
  width: 130rpx;
  margin-left: 8rpx;
  background: #8ceef0;
  color: #111214;
}

.primary-btn {
  flex: 1;
  margin-left: 8rpx;
  gap: 6rpx;
  background: #8ceef0;
  color: #111214;
}

.primary-free {
  font-size: 16rpx;
  font-style: italic;
  font-weight: 700;
}

.primary-text {
  font-size: 20rpx;
  font-weight: 700;
}
