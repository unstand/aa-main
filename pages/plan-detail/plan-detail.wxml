<view class="plan-detail-page">
  <image class="page-bg" src="/images/home-bj.png" mode="aspectFill"></image>
  <view class="page-mask"></view>
  <view class="page-frost"></view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="error-wrap" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="loadPlanDetail">
      <text>重新加载</text>
    </view>
  </view>

  <block wx:else>
    <view class="status-bar"></view>

    <view class="top-bar">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon">&lt;</text>
      </view>
      <view class="nav-actions">
        <text class="nav-dots">...</text>
        <view class="nav-split"></view>
        <view class="nav-circle"></view>
      </view>
    </view>

    <scroll-view scroll-y class="content-scroll" scroll-into-view="{{scrollIntoView}}">
      <view class="hero-swiper-section">
        <swiper class="hero-swiper" circular previous-margin="60rpx" next-margin="60rpx" current="{{swiperCurrent}}" bindchange="onHeroSwiperChange">
          <swiper-item wx:for="{{detail.images}}" wx:key="url">
            <view class="hero-swiper-item {{swiperCurrent === index ? 'active' : ''}}">
              <image class="hero-image" src="{{item.url}}" mode="aspectFill"></image>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <view class="intro-section">
        <text class="intro-title">{{detail.title}}</text>
        <text class="intro-line" wx:for="{{detail.description}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="glass-card booking-card">
        <view class="booking-top">
          <view class="guest-control">
            <text class="booking-label">人数</text>
            <view class="mini-stepper">
              <view class="mini-stepper-btn" bindtap="onGuestMinus">-</view>
              <text class="mini-stepper-value">{{guestCount}}</text>
              <view class="mini-stepper-btn" bindtap="onGuestPlus">+</view>
            </view>
          </view>
          <text class="booking-price">¥{{detail.booking.price}}/人</text>
        </view>
        <view class="booking-dates">
          <view class="date-col">
            <text class="date-main">{{detail.booking.startDate}}</text>
            <text class="date-sub">10:00</text>
          </view>
          <view class="date-center">共 {{detail.booking.totalDays}} 日</view>
          <view class="date-col date-col-right">
            <text class="date-main">{{detail.booking.endDate}}</text>
            <text class="date-sub">10:00</text>
          </view>
        </view>
        <view class="booking-location">
          <view class="location-card">
            <text class="location-label">城市</text>
            <text class="location-value">{{detail.booking.city}}</text>
          </view>
          <view class="location-card location-card-wide">
            <text class="location-label">出发点</text>
            <text class="location-value">{{detail.booking.departurePoint}}</text>
          </view>
        </view>
      </view>

      <view class="map-card">
        <image class="map-image" src="{{detail.map.image}}" mode="aspectFill"></image>
        <view class="map-pin">
          <text class="map-pin-icon">⌖</text>
        </view>
      </view>

      <view class="glass-card resource-card" wx:if="{{detail.vehicle}}">
        <view class="resource-top">
          <view class="resource-copy">
            <text class="resource-title">{{detail.vehicle.name}}</text>
            <text class="resource-sub">{{detail.vehicle.specs}}</text>
            <text class="resource-sub">{{detail.vehicle.features}}</text>
          </view>
          <view class="resource-media-badge">♪</view>
        </view>
        <view class="resource-action-row">
          <text class="resource-price">¥{{detail.vehicle.price}}/车/日</text>
          <view class="mini-stepper">
            <view class="mini-stepper-btn" bindtap="onVehicleMinus">-</view>
            <text class="mini-stepper-value">{{vehicleCount}}</text>
            <view class="mini-stepper-btn" bindtap="onVehiclePlus">+</view>
          </view>
          <view class="outline-btn" bindtap="onModifyVehicle">
            <text>修改车辆</text>
          </view>
        </view>
        <view class="resource-image-shell">
          <image class="resource-image" src="{{detail.vehicle.images[0]}}" mode="aspectFit"></image>
        </view>
      </view>

      <view class="glass-card resource-card resource-card-service" wx:if="{{detail.service}}">
        <view class="resource-top">
          <view class="resource-copy">
            <text class="resource-title">{{detail.service.name}}</text>
            <text class="resource-sub">{{detail.service.specs}}</text>
          </view>
          <view class="resource-media-badge">♪</view>
        </view>
        <view class="resource-action-row">
          <text class="resource-price">¥{{detail.service.price}}/包/日</text>
          <view class="mini-stepper">
            <view class="mini-stepper-btn" bindtap="onServiceMinus">-</view>
            <text class="mini-stepper-value">{{serviceCount}}</text>
            <view class="mini-stepper-btn" bindtap="onServicePlus">+</view>
          </view>
          <view class="outline-btn" bindtap="onModifyService">
            <text>修改服务</text>
          </view>
        </view>
      </view>

      <view class="tab-section" id="tab-section">
        <view class="tab-bar">
          <view class="tab-item {{activeTab === 'activity' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="activity">
            <text>活动</text>
            <view class="tab-line" wx:if="{{activeTab === 'activity'}}"></view>
          </view>
          <view class="tab-item {{activeTab === 'schedule' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="schedule">
            <text>详细日程</text>
            <view class="tab-line" wx:if="{{activeTab === 'schedule'}}"></view>
          </view>
          <view class="tab-item {{activeTab === 'fee' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="fee">
            <text>费用须知</text>
            <view class="tab-line" wx:if="{{activeTab === 'fee'}}"></view>
          </view>
        </view>

        <view class="tab-panel tab-panel-activity" wx:if="{{activeTab === 'activity'}}">
          <view class="activity-poster">
            <image class="activity-poster-image" src="/images/邀请长图（新疆自驾） 1.png" mode="widthFix"></image>
            <view class="poster-float poster-top">
              <text class="poster-title">越野西行</text>
              <text class="poster-title poster-title-second">凝望恶魔之眼</text>
              <text class="poster-tag">6天5晚 2-8人小团</text>
            </view>
            <view class="poster-float poster-bottom">
              <view class="poster-meta-row">
                <text class="poster-meta">2人起拼</text>
                <text class="poster-meta">专业领队</text>
                <text class="poster-meta">景区门票</text>
                <text class="poster-meta">越野座驾</text>
              </view>
            </view>
          </view>
        </view>

        <view class="tab-panel tab-panel-schedule" wx:if="{{activeTab === 'schedule'}}">
          <view class="schedule-card">
            <view class="schedule-day" wx:for="{{detail.schedule}}" wx:key="day">
              <view class="schedule-day-header">
                <text class="schedule-day-num">DAY{{item.day}}</text>
                <text class="schedule-day-title">{{item.title}}</text>
              </view>
              <view class="schedule-timeline">
                <view class="schedule-period" wx:for="{{item.periods}}" wx:for-item="period" wx:key="time">
                  <view class="period-left">
                    <text class="period-time">{{period.time}}</text>
                    <view class="period-marker-wrap">
                      <view class="period-icon period-icon-{{period.type}}"></view>
                      <view class="period-line"></view>
                    </view>
                  </view>
                  <view class="period-content">
                    <text class="period-item" wx:for="{{period.items}}" wx:for-item="line" wx:key="*this">{{line}}</text>
                  </view>
                </view>
              </view>
              <view class="schedule-transport" wx:if="{{item.transport}}">
                <text class="transport-icon">!</text>
                <text class="transport-text">交通 {{item.transport.duration}} {{item.transport.distance}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="tab-panel tab-panel-fee" wx:if="{{activeTab === 'fee'}}">
          <view class="fee-card">
            <view class="fee-section" wx:for="{{detail.feeSections}}" wx:key="title">
              <view class="fee-section-header">
                <text class="fee-section-title">{{item.title}}</text>
                <view class="fee-section-dot"></view>
              </view>
              <view class="fee-section-body">
                <text class="fee-section-item" wx:for="{{item.items}}" wx:for-item="line" wx:key="*this">{{line}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <view class="bottom-shell">
      <view class="bottom-bar">
        <view class="total-box">
          <text class="total-label">总价:</text>
          <text class="total-value">¥{{totalPrice}}</text>
        </view>
        <view class="action-btn contact-btn" bindtap="onContactUs">联系我们</view>
        <view class="action-btn primary-btn" bindtap="onGeneratePlan">
          <text class="primary-free">free</text>
          <text class="primary-text">生成计划</text>
        </view>
      </view>
    </view>

    <contact-popup visible="{{showContactPopup}}" bind:close="onCloseContactPopup"></contact-popup>
  </block>
</view>
