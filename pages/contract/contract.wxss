/* pages/contract/contract.wxss */
.text{
  font-family: "Alimama FangYuanTi VF", sans-serif;
font-weight: 400; /* Regular */
font-size: 20rpx;    /* 10px × 2 = 20rpx */
line-height: 24rpx;  /* 12px × 2 = 24rpx */
letter-spacing: 0rpx;
text-align: left;
color: rgba(255, 255, 255, 1);
}
.contract-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #13283a 0%, #0a1724 100%);
}

.content-scroll {
  height: calc(100vh - 120rpx);
  padding: 0 30rpx;
  box-sizing: border-box;
}

.top-bar {
  position: relative;
  display: flex;
  padding-top: calc(100rpx + env(safe-area-inset-top));
  padding-bottom: 24rpx;
  z-index: 10;
}

.back-btn {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  z-index: 2;
  background-color: rgba(17, 34, 52, 0.67);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid rgba(203, 202, 202, 1);
  border-bottom: 4rpx solid rgba(203, 202, 202, 1);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.paper-shell {
  padding-bottom: 24rpx;
}

.paper-card {
  background: transparent;
  padding: 44rpx 34rpx 40rpx;
}

.contract-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.contract-title {
  font-size: 40rpx;
  line-height: 56rpx;
  color: #2b2116;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.contract-no-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.contract-no-label,
.info-label,
.static-label,
.paragraph-text,
.agreement-text {
  font-size: 24rpx;
  line-height: 40rpx;
  color: #4c4034;
}

.section {
  margin-bottom: 26rpx;
}

.intro-section {
  border-top: 1rpx solid rgba(93, 73, 52, 0.18);
  padding-top: 22rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #2f2418;
  font-weight: 600;
  white-space: nowrap;
}

.section-title-line {
  flex: 1;
  height: 1rpx;
  background: rgba(93, 73, 52, 0.2);
  margin-left: 16rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 0;
}

.info-item {
  width: 50%;
  display: flex;
  align-items: center;
}

.info-item.full {
  width: 100%;
}

.info-label {
  width: 140rpx;
  flex-shrink: 0;
}

.underline-field {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  border-bottom: 2rpx solid #7f6a52;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.underline-field.inline {
  display: inline-flex;
  vertical-align: middle;
}

.underline-field.inline + .paragraph-text {
  margin-left: 6rpx;
}

.underline-no {
  width: 220rpx;
  flex: none;
}

.underline-input {
  width: 100%;
  height: 100%;
  font-family: "Alimama FangYuanTi VF", sans-serif;
font-weight: 400; /* Regular */
font-size: 20rpx;    /* 10px × 2 = 20rpx */
line-height: 24rpx;  /* 12px × 2 = 24rpx */
letter-spacing: 0rpx;
text-align: center;
  color: rgba(255, 255, 255, 1);
}

.underline-input.center {
  text-align: center;
}

.static-info-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.static-info-row {
  display: flex;
  align-items: flex-start;
}

.static-label {
  width: 196rpx;
  flex-shrink: 0;
}

.static-value {
  flex: 1;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #2f2418;
}

.contract-section {
  border-top: 1rpx solid rgba(93, 73, 52, 0.18);
  padding-top: 24rpx;
}

.clause-title {
  display: block;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #2f2418;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.contract-paragraph,
.contract-line-wrap,
.signature-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}

.date-group {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  row-gap: 10rpx;
}

.date-group.compact {
  flex: 1;
  min-width: 0;
}

.paragraph-gap {
  margin-left: 12rpx;
}

.year-field {
  width: 96rpx;
  flex: none;
  margin: 0 6rpx;
}

.mini-field {
  width: 56rpx;
  flex: none;
  margin: 0 6rpx;
}

.money-field {
  width: 132rpx;
  flex: none;
  margin: 0 6rpx;
}

.flex-mini {
  width: 80rpx;
  flex: none;
  margin: 0 6rpx;
}

.flex-wide {
  min-width: 220rpx;
  margin: 0 6rpx;
}

.place-field {
  width: 220rpx;
  flex: none;
  margin: 0 6rpx;
}

.text-block,
.bullet-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.strong {
  color: #2f2418;
  font-weight: 700;
}

.top-gap {
  margin-top: 8rpx;
}

.final-section {
  margin-bottom: 10rpx;
}

.signature-panel {
  margin-top: 20rpx;
}

.signature-label {
  width: 108rpx;
  flex-shrink: 0;
}

.signature-field {
  min-width: 260rpx;
}

.signature-date-row {
  margin-top: 8rpx;
}

.agreement-section {
  padding: 24rpx 8rpx 8rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(251, 247, 239, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #8ceef0;
  border-color: #8ceef0;
}

.checkbox-icon {
  color: #0e1b28;
  font-size: 22rpx;
  font-weight: 700;
}

.agreement-text {
  color: rgba(251, 247, 239, 0.88);
}

.safe-bottom {
  height: 160rpx;
}

.bottom-bar {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 42rpx;
  height: 120rpx;
  z-index: 9999;
  padding: 10rpx;
  border-radius: 32rpx;
  background: rgba(29, 45, 61, 0.12);
  backdrop-filter: blur(40rpx);
  box-shadow:
    0 4rpx 16rpx 0 rgba(0, 0, 0, 0.25),
    inset 0 2rpx 8rpx 4rpx rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 1);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  -webkit-backdrop-filter: blur(18px);
}

.total-box {
  width: 190rpx;
  height: 100%;
  padding-left: 18rpx;
  border-radius: 24rpx;
  background: rgba(18, 26, 39, 0.96);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.total-label {
  font-family: "Noto Sans SC", sans-serif;
  font-weight: 400;
  font-size: 24rpx;
  line-height: 34rpx;
  letter-spacing: 0rpx;
  text-align: left;
  color: rgba(147, 238, 238, 1);
}

.total-value {
  font-family: "Noto Sans SC", sans-serif;
  font-weight: 400;
  font-size: 28rpx;
  line-height: 34rpx;
  letter-spacing: 0rpx;
  text-align: left;
  color: rgba(147, 238, 238, 1);
}

.action-btn {
  height: 100%;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.contact-btn {
  width: 162rpx;
  margin-left: 12rpx;
  background: #8ceef0;
  color: #111214;
}

.primary-btn {
  flex: 1;
  margin-left: 12rpx;
  background: #8ceef0;
  color: #111214;
}

.primary-text {
  font-family: "Alimama FangYuanTi VF", sans-serif;
  font-weight: 500;
  font-size: 28rpx;
  line-height: 34rpx;
  letter-spacing: 0rpx;
  text-align: center;
  color: rgba(0, 0, 0, 1);
}
